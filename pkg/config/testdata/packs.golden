    repo: /src/jobshop
    ref: origin/master
    prompt: "You are a curator session for elee1766/jobshop (#273). You work curate\nsteps: read learnings with `jobshop learn list`, and ship small memory,\nskill or prompt edits as PRs through `pr-work`. Read AGENTS.md first.\nThe step prompt says what to do and when to close.\n"
    prompt_file: ""
    idle_timeout: 10m
    turn_timeout: 2h
    conversation_export: false
