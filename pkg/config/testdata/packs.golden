        check: "gh pr list --repo elee1766/jobshop --state open --json number,isDraft,updatedAt,statusCheckRollup,author,labels --jq ' (\"elee1766,\" | ascii_downcase | split(\",\") | map(select(. != \"\"))) as $skipa | (\"hold\" | ascii_downcase | split(\",\") | map(select(. != \"\"))) as $skipl | .[] | select(.isDraft | not) | select(.author.login | ascii_downcase | IN($skipa[]) | not) | select(any(.labels[].name | ascii_downcase; IN($skipl[])) | not) | select((.statusCheckRollup | length) > 0 and all(.statusCheckRollup[]; .conclusion == \"SUCCESS\" or .conclusion == \"SKIPPED\" or .conclusion == \"NEUTRAL\")) | select((now - (.updatedAt | fromdateiso8601)) > 7200) | \"\\(.number) green, unmerged since \\(.updatedAt)\"'"
        repo: ""
        team: ""
        states: ""
        labels: ""
        skip_labels: ""
        poll: ""
      - signal: no_merge
        after: ""
        check: "test \"$(gh pr list --repo elee1766/jobshop --state open --json number --jq length)\" -gt 0 && gh api repos/elee1766/jobshop/commits/master --jq 'select((now - (.commit.committer.date | fromdateiso8601)) > 21600) | \"\\(.sha[0:12]) last commit \\(.commit.committer.date)\"'"
        repo: ""
        team: ""
        states: ""
        labels: ""
        skip_labels: ""
        poll: ""
      learnings: null
      edits: null
    ticket: null
    run:
      workflow: stall-check
      vars:
        detail: <stall_detail>
        signal: <stall_signal>
        subject: <stall_subject>
      key: ""
    cooldown: 30m
    max_runs: 2
