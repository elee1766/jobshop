        repo: ""
        team: ""
        states: ""
        labels: ""
        skip_labels: ""
        poll: ""
      - signal: needs_human
        after: 4h
        check: ""
        repo: ""
        team: ""
        states: ""
        labels: ""
        skip_labels: ""
        poll: ""
      - signal: blocked
        after: 1h
        check: ""
        repo: ""
        team: ""
        states: ""
        labels: ""
        skip_labels: ""
        poll: ""
      - signal: issue_no_run
        after: ""
        check: "gh issue list --repo elee1766/acphost --state open --limit 200 --json number,labels,title,createdAt,author --jq ' (\"wile,x,y\" | ascii_downcase | split(\",\") | map(select(. != \"\"))) as $ok | .[] | select(.author.is_bot or ([.author.login | ascii_downcase] | inside($ok)) or ([.labels[].name] | any(. == \"accepted\"))) | select([.labels[].name] | any(. == \"target\" or . == \"needs-decision\" or . == \"needs-human\" or . == \"tracking\" or . == \"proposed\") | not) | select(.title | test(\"^drill\"; \"i\") | not) | select((now - (.createdAt | fromdateiso8601)) > 1800) | \"\\(.number) open, no run\"'"
        repo: elee1766/acphost
        team: ""
        states: ""
        labels: ""
        skip_labels: ""
        poll: ""
      - signal: linear_issue_no_run
        after: ""
        check: ""
        repo: ""
        team: ""
        states: Todo
        labels: ""
        skip_labels: Blocked
        poll: 5m
      - signal: pr_unmerged
        after: ""
        check: "gh pr list --repo elee1766/acphost --state open --json number,isDraft,updatedAt,statusCheckRollup,author,labels --jq ' (\"wile,\" | ascii_downcase | split(\",\") | map(select(. != \"\"))) as $skipa | (\"hold\" | ascii_downcase | split(\",\") | map(select(. != \"\"))) as $skipl | .[] | select(.isDraft | not) | select(.author.login | ascii_downcase | IN($skipa[]) | not) | select(any(.labels[].name | ascii_downcase; IN($skipl[])) | not) | select((.statusCheckRollup | length) > 0 and all(.statusCheckRollup[]; .conclusion == \"SUCCESS\" or .conclusion == \"SKIPPED\" or .conclusion == \"NEUTRAL\")) | select((now - (.updatedAt | fromdateiso8601)) > 7200) | \"\\(.number) green, unmerged since \\(.updatedAt)\"'"
