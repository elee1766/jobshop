{
  "name": "jobshop-desk",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "lint": "oxlint --deny-warnings src",
    "format": "oxfmt --write src vite.config.ts",
    "format:check": "oxfmt --check src vite.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test:unit": "node --test src/lib/activity.test.ts src/lib/route.test.ts src/lib/search.test.ts src/lib/timeline.test.ts src/lib/history.test.ts src/lib/detail.test.ts src/lib/browse.test.ts src/lib/session.test.ts src/lib/learn.test.ts kit/links.test.js kit/titles.test.js ../packages/jobshop-client/index.test.js",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "node e2e/run-isolated.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "dompurify": "3.4.17",
    "marked": "18.1.3",
    "oxc-transform-react": "0.156.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-hotkeys": "0.22.3",
    "@tanstack/react-virtual": "3.14.26",
    "fuse.js": "7.5.0",
    "jotai": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wouter": "3.13.0"
  }
}
